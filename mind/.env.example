# ==========================================================================
# MIND — Muñdji Intelligent Neural Developer
# Configuração de ambiente (copiar para .env e preencher)
# ==========================================================================

# --- Modo de execução dos modelos ---------------------------------------
# Os modelos são todos do HuggingFace, alguns retreinados (fine-tuned), e
# correm em GPU alugada na cloud (vast.ai e afins). Ver
# docs/decisoes/gpu_alugada.md.
#
# openai_compat  servidor compatível com OpenAI (vLLM, TGI, llama.cpp).
#                RECOMENDADO para GPU alugada: o servidor gere a GPU e
#                adaptadores LoRA são servidos como modelos distintos.
# hf_local       transformers em processo — usar quando o MIND corre NA
#                própria máquina da GPU (exige requirements-hf.txt)
# hf_api         HuggingFace Inference API / Inference Endpoints (remoto)
# ollama         mantido para compatibilidade com instalações locais
MODEL_MODE=openai_compat
GPU_COUNT=1

# Endpoint por omissão, usado por qualquer componente que não defina o seu.
# Numa GPU alugada é o URL do servidor de inferência (com HTTPS ou através
# de túnel SSH/WireGuard — ver nota de segurança na documentação).
MODEL_ENDPOINT=http://localhost:8000

# --- CORTEX (orquestrador, persona JARVIS, maior modelo disponível) -----
# O modelo pode ser um id do Hub, o nome de um adaptador LoRA servido, ou
# um caminho de disco para um checkpoint afinado. Ex:
#   CORTEX_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
#   CORTEX_MODEL=cortex-lora-v3
#   CORTEX_MODEL=/models/finetuned/cortex
CORTEX_ENDPOINT=
CORTEX_MODEL=

# --- CEREBELLUM (revisor, modelo médio-alto) ----------------------------
CEREBELLUM_ENDPOINT=
CEREBELLUM_MODEL=

# --- NEURONS (existência no sistema; NÃO controla activação por ronda) ---
# ENABLE_NEURON_N define apenas se o NEURON existe/está disponível.
# A decisão de correr ou não numa iteração é sempre dinâmica e do CORTEX.
ENABLE_NEURON_1=true
ENABLE_NEURON_2=true
ENABLE_NEURON_3=true
ENABLE_NEURON_4=true
ENABLE_NEURON_5=true
ENABLE_NEURON_6=true

NEURON_1_ENDPOINT=
NEURON_1_MODEL=
NEURON_2_ENDPOINT=
NEURON_2_MODEL=
NEURON_3_ENDPOINT=
NEURON_3_MODEL=
NEURON_4_ENDPOINT=
NEURON_4_MODEL=
NEURON_5_ENDPOINT=
NEURON_5_MODEL=
NEURON_6_ENDPOINT=
NEURON_6_MODEL=

# --- Autenticação dos endpoints de inferência ---------------------------
# Um servidor de inferência em GPU alugada tem de estar protegido: sem
# token, quem descobrir o URL usa a tua GPU e vê os teus prompts.
# Precedência: token do componente > MODEL_AUTH_TOKEN > HUGGINGFACE_API_KEY.
MODEL_AUTH_TOKEN=
CORTEX_TOKEN=
CEREBELLUM_TOKEN=
NEURON_1_TOKEN=
NEURON_2_TOKEN=
NEURON_3_TOKEN=
NEURON_4_TOKEN=
NEURON_5_TOKEN=
NEURON_6_TOKEN=

# Token da HuggingFace: descarregar modelos privados (checkpoints afinados)
# e usar o modo hf_api.
HUGGINGFACE_API_KEY=

# --- Retry com backoff em cada chamada a modelo -------------------------
MODEL_MAX_RETRIES=3
MODEL_RETRY_BACKOFF_SECONDS=2

# --- Ciclo do MIND ------------------------------------------------------
MUNDJI_WORKSPACE=./workspace
MUNDJI_MAX_ITERATIONS=10
MUNDJI_SANDBOX_TIMEOUT=30
APPROVAL_THRESHOLD=98
DIVERGENCE_THRESHOLD=15
NEURON_TIMEOUT_SECONDS=60
ENABLE_ROLLBACK=true

# --- Versionamento git local (workspace/) -------------------------------
GIT_PERMANENT_THRESHOLD=70

# --- Sanitização de output ----------------------------------------------
OUTPUT_SANITIZER_ENABLED=true

# --- Backup (APScheduler; off-site sempre local/rede privada) -----------
BACKUP_INTERVAL_MINUTES=15
BACKUP_RETENTION_HOURS=24
BACKUP_DAILY_RETENTION_DAYS=30
BACKUP_OFFSITE_PATH=

# ==========================================================================
# EXTENSÃO — CAMADA HIPPOCAMPUS (apoio de Machine Learning)
# ==========================================================================
# Só activar depois da base estar funcional e validada, E quando houver
# volume de ciclos reais acumulado na SYNAPSE DB. Com ML_ENABLED=false todo
# o sistema funciona exactamente como a base, sem qualquer chamada a esta
# camada.
#
# Nota de hardware: sentence-transformers puxa torch (peso considerável,
# compete com os LLMs pela GPU). Confirmar capacidade antes de activar.
ML_ENABLED=false                    # desligado por defeito até haver dados
ML_TRAINING_INTERVAL_HOURS=24
ML_MIN_TRAINING_SAMPLES=100
ML_AUTO_REJECT_CONFIDENCE=0.9
ML_RETRAIN_DEVIATION_THRESHOLD=20

# ==========================================================================
# EXTENSÃO — SANDBOX DE TESTES EVOLUTIVA
# ==========================================================================
# Desligada por defeito. Com SANDBOX_TESTS_ENABLED=false o sistema
# comporta-se exactamente como antes desta extensão: a sandbox executa o
# código e observa se rebenta, e a percentagem é estimada pelo modelo.
#
# Activada, o CEREBELLUM gera testes reais antes dos NEURONS desenvolverem,
# o rigor escala a cada iteração (básico -> limite -> erro), e a
# percentagem passa a ser MEDIDA sobre os resultados em vez de estimada.
SANDBOX_TESTS_ENABLED=false
SANDBOX_ACCUMULATE_LEVELS=true      # níveis acumulativos (default)
SANDBOX_MAX_ITER_PER_LEVEL=3        # máximo de iterações por nível
SANDBOX_TESTS_PER_LEVEL=8           # testes a gerar por nível por ciclo
SANDBOX_MIN_LIBRARY_SIMILARITY=0.75 # similaridade mínima p/ herdar testes
