# Ambiente
.env

# SYNAPSE DB (dados operacionais locais — nunca versionar)
synapse.db
synapse.db-wal
synapse.db-shm

# Backups gerados
backups/*.db

# Workspace de execução (git local interno + sandbox + output + snapshots).
# Tudo dentro de workspace/ é artefacto de execução; só o .gitkeep se versiona.
workspace/*
!workspace/.gitkeep

# Datasets exportados
datasets/*.jsonl

# Python
__pycache__/
*.pyc
.venv/
venv/

# Modelos treinados do HIPPOCAMPUS (artefactos locais, não versionar)
models/hippocampus/*.joblib
models/hippocampus/*.pkl

# Exportações ML
datasets/*.csv

# Cache do pytest
.pytest_cache/
